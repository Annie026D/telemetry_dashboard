  "DriveCommandResultEvent": {
    "multicast_group": "239.255.0.1:5000",
    "topic_config_key": "MQTT_TOPIC_DRIVE_RESPONSE",
    "defined_in": "main.c",
    "description": "Event emitted after command execution (result + drive_state snapshot).",
    "envelope": {
      "v": "number (1)",
      "type": "string (Event)",
      "name": "string (DriveCommandResult)",
      "src": "string (lcu)",
      "meta": "object (empty)"
    },
    "body_fields": {
      "id": "string",
      "name": "string",
      "axis": "string",
      "result_code": "string (e.g., OK, INVALID_AXIS, DRIVE_DISCONNECTED)",
      "drive_state": {
        "tilt": "object {has_motion_params, velocity, accel, decel, target_deg, target_pos}",
        "pan": "object {has_motion_params, velocity, accel, decel, target_deg, target_pos}"
      }
    }
  },
  "WcsStatusReply": {
    "multicast_group": "239.255.0.1:5000",
    "topic_config_key": "MQTT_TOPIC_WCS_STATUS_TX",
    "defined_in": ["ack_builder.c", "wcs_io_commands.c", "main.c"],
    "description": "ACK/Reply payload corresponding to WCS commands (includes drive_state + optional IO reply).",
    "envelope": {
      "v": "number (1)",
      "id": "string (matches command id)",
      "type": "string (Reply)",
      "name": "string (matches command name)",
      "src": "string (lcu)",
      "meta": "object (empty)"
    },
    "body_fields": {
      "result": {
        "ok": "boolean",
        "code": "string (OK/ERROR/INVALID_AXIS/DRIVE_DISCONNECTED/IO_NOT_READY/etc.)",
        "message": "string"
      },
      "drive_state": {
        "tilt": "object {has_motion_params, velocity, accel, decel, target_deg, target_pos, last_update_ms}",
        "pan": "object {has_motion_params, velocity, accel, decel, target_deg, target_pos, last_update_ms}"
      },
      "io": {
        "kind": "string (DI_BIT|DI_ALL|DO_BIT|DO_ALL|DO_WRITE_ACK)",
        "connected": "boolean",
        "channel": "number (optional)",
        "value": "number (optional)",
        "di_bits": "number (optional)",
        "di_bits_hex": "string (optional)",
        "do_bits": "number (optional)",
        "do_bits_hex": "string (optional)",
        "mask": "number (optional)",
        "mask_hex": "string (optional)",
        "requested": "number (optional)",
        "requested_hex": "string (optional)"
      }
    }
  },
  "TelemetryOncePayload": {
    "multicast_group": "239.255.0.1:5000",
    "topic_config_key": "MQTT_TOPIC_DRIVE_TELEMETRY",
    "defined_in": "telemetry.c",
